# Uma das duas variáveis abaixo é suficiente.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# HERMES_GEMINI_API_KEY=

# O modelo pode ser trocado sem alterar código.
GEMINI_MODEL=gemini-2.5-flash-lite
PORT=3000
DATA_DIR=./data
HOST=127.0.0.1

# Gere o hash com: node scripts/hash-password.mjs 'uma senha longa'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
BOT_CHALLENGE_SECRET=

# Durante o desenvolvimento, deixe 0 para substituir gerações antigas.
# No lançamento oficial, use 1 para preservar cada revisão do Gemini.
PRESERVE_GENERATED_HISTORY=0

# Analytics público. Deixe ambos vazios para desativar silenciosamente.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
